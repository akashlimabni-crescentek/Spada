// Refer to README for what these values are + where to obtain them

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

// Local / E2E only: explicitly opt in to skip login redirects (never honored in production).
// Production (NODE_ENV=production or VERCEL_ENV=production) always enforces auth.
E2E_BYPASS_AUTH=true

